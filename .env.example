# ==========================================
# Makkal Kural (மக்கள் குரல்) Environment Configuration
# ==========================================

# Supabase (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend Transactional Email
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Makkal Kural <noreply@makkalkural.org>

# Official X (Twitter) API
# For posting tweets tagging ministers: set X_USER_ACCESS_TOKEN to a user-access token with tweet.write scope.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_ACCESS_TOKEN=
X_REDIRECT_URI=http://localhost:3000/api/auth/callback/x

# WhatsApp Business API (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=

# Twilio SMS (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RECIPIENT_SMS_NUMBER=

# Government Portal API (Optional)
GOVT_PORTAL_API_URL=
GOVT_PORTAL_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Access Passkey (For local development & admin demo fallback)
ADMIN_SECRET_KEY=makkal_kural_admin_2026
